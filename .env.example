# ===================================================================
# Variables de Entorno del Frontend (Next.js / Vercel)
# Copiar como .env.local para desarrollo o cargar en Vercel Dashboard
# ===================================================================

# URL pública del Backend Spring Boot (sin barra final)
# Ejemplo en producción: https://libreria-motivos-api.up.railway.app
NEXT_PUBLIC_API_URL=http://localhost:8080

# Dejar en false en producción (solo true para demos sin backend)
NEXT_PUBLIC_DEMO_MODE=false
